{
  "name": "sanad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-ort.mjs && pnpm validate:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "validate:data": "tsx scripts/validate-data.ts",
    "test:e2e": "playwright test",
    "hardcases": "tsx scripts/hardcases.ts",
    "eval:e2e": "tsx scripts/eval-e2e.ts",
    "eval:all": "pnpm test && pnpm hardcases --runs 3 && pnpm eval:e2e",
    "copy:ort": "node scripts/copy-ort.mjs",
    "predev": "node scripts/copy-ort.mjs",
    "check:tagger": "tsx scripts/check-tagger.ts",
    "eval:explorer": "tsx scripts/eval-explorer.ts",
    "build:corpus": "tsx scripts/build-corpus.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@huggingface/transformers": "^4.3.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
